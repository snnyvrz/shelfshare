# Shared local-development environment.
# Copy this file to .env.dev before starting the services.

# Docker Compose / PostgreSQL container settings
POSTGRES_PORT=5432
POSTGRES_USER=shelfshare
POSTGRES_PASSWORD=shelfshare
POSTGRES_DB=shelfshare

# books-service application settings
# Use localhost when the service runs on the host. Use postgres when it runs
# inside the same Docker Compose network.
DB_HOST=localhost
DB_PORT=5432
DB_USER=shelfshare
DB_PASS=shelfshare
DB_NAME=shelfshare
DB_SSLMODE=disable
GIN_MODE=debug
TZ=UTC

# Docker Compose / MongoDB container settings
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=root
MONGO_INITDB_DATABASE=shelfshare

# auth-service application settings (JWT_SECRET is shared by all three apps)
# Use localhost when the service runs on the host. Use mongo when it runs
# inside the same Docker Compose network.
MONGO_HOST=localhost
JWT_SECRET=local-development-secret-change-me
JWT_EXPIRES_IN=3600

# SvelteKit server-side API endpoints
BOOKS_API_URL=http://localhost:8080/api
AUTH_API_URL=http://localhost:3030/api/auth

# Browser-reachable WebSocket URL (use wss:// in production).
# REST BOOKS_API_URL may be internal; the browser must reach this endpoint.
BOOKS_WS_URL=ws://localhost:8080/api/ws
