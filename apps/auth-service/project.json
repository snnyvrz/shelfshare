{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "auth-service",
    "root": "apps/auth-service",
    "sourceRoot": "apps/auth-service/src",
    "projectType": "application",
    "targets": {
        "serve": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/auth-service",
                "command": "node --env-file-if-exists=../../.env.dev --import tsx --watch src/main.ts"
            }
        },
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{projectRoot}/dist"],
            "options": {
                "command": "tsc -p apps/auth-service/tsconfig.build.json"
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "env": {
                    "TSX_TSCONFIG_PATH": "apps/auth-service/tsconfig.json"
                },
                "command": "node --import tsx --test apps/auth-service/src/**/*.test.ts"
            }
        }
    }
}
